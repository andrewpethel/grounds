{
  "name": "grounds",
  "private": true,
  "version": "0.1.0",
  "description": "A local service operations workspace for Windows.",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run validate:intelligence && npm run validate:srm && npm run validate:ev2",
    "validate:services": "node tools/validate-services.mjs",
    "validate:troubleshooting": "node tools/validate-troubleshooting.mjs",
    "validate:intelligence": "node tools/validate-teams-intelligence.mjs",
    "validate:srm": "node tools/validate-srm-observations.mjs",
    "validate:ev2": "node tools/validate-ev2-service-groups.mjs",
    "build": "npm run validate:troubleshooting && tsc -b && vite build",
    "preview": "vite preview",
    "dev:demo": "vite --config demo/vite.config.ts",
    "build:demo": "tsc -p demo/tsconfig.json && vite build --config demo/vite.config.ts",
    "preview:demo": "vite preview --config demo/vite.config.ts",
    "test:demo": "npm run build:demo && node --test demo/tests/smoke.mjs",
    "package:demo": "npm run build:demo && powershell.exe -NoProfile -NonInteractive -File demo/tools/package.ps1",
    "srm:poc": "node tools/srm-browser-poc.mjs",
    "typecheck": "tsc -b",
    "desktop:build": "tsc -b && vite build --mode desktop",
    "desktop": "npm run desktop:build && electron .",
    "desktop:package": "npm run desktop:build && electron-builder --win nsis",
    "test:desktop": "node --test desktop/*.test.mjs",
    "test:desktop:smoke": "node desktop/smoke.mjs"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.24",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chokidar": "^4.0.3",
    "connect": "^3.7.0",
    "elkjs": "^0.12.0",
    "jsonc-parser": "^3.3.1",
    "playwright-core": "^1.55.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "electron": "^43.7.9",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.grounds.desktop",
    "productName": "Grounds",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-desktop/**",
      "desktop/**",
      "!desktop/*.test.mjs",
      "!desktop/smoke.mjs",
      "tools/**",
      "*_schema.json",
      "intelligence/**/*.example.json",
      "package.json"
    ],
    "asarUnpack": [
      "tools/**",
      "node_modules/@github/copilot-sdk*/**",
      "node_modules/koffi/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
