{
  "name": "grounds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run validate:intelligence && npm run validate:srm && npm run validate:ev2",
    "validate:services": "node tools/validate-services.mjs",
    "validate:troubleshooting": "node tools/validate-troubleshooting.mjs",
    "validate:intelligence": "node tools/validate-teams-intelligence.mjs",
    "validate:srm": "node tools/validate-srm-observations.mjs",
    "validate:ev2": "node tools/validate-ev2-service-groups.mjs",
    "build": "npm run validate:troubleshooting && tsc -b && vite build",
    "preview": "vite preview",
    "srm:poc": "node tools/srm-browser-poc.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "playwright-core": "^1.55.0",
    "vite": "^7.1.7",
    "typescript": "^5.9.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9"
  }
}
