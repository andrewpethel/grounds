{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.com/service-troubleshooting.schema.json",
  "title": "Service Troubleshooting Knowledge",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "serviceName", "components", "monitors", "telemetry", "playbooks"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "serviceName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "monitors": {
      "type": "array",
      "items": { "$ref": "#/$defs/monitor" }
    },
    "telemetry": {
      "type": "array",
      "items": { "$ref": "#/$defs/telemetry" }
    },
    "playbooks": {
      "type": "array",
      "items": { "$ref": "#/$defs/playbook" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "type", "location"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["repository", "dashboard", "runbook", "query", "documentation", "other"]
        },
        "location": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "repositoryPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "searchTerms": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        },
        "environments": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "monitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "system", "description", "signals"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "system": { "type": "string", "minLength": 1 },
        "component": { "type": "string" },
        "description": { "type": "string", "minLength": 1 },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "namespace": { "type": "string" },
              "metric": { "type": "string" },
              "dimensions": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "repositoryPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "searchTerms": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        },
        "knownFailureModes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "system", "purpose"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "system": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "cluster": { "type": "string" },
        "database": { "type": "string" },
        "tables": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "namespaces": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "queryGuidance": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "playbook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "symptoms", "investigationSteps"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "symptoms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "investigationSteps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "possibleCauses": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "searchTerms": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        }
      }
    }
  }
}
